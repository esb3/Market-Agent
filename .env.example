# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# FRED (VIX, VIX9D, VIX3M, 3-month T-bill): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# SMTP delivery. For Gmail, BRIEFING_SMTP_PASSWORD is an App Password
# (https://myaccount.google.com/apppasswords), not your normal login
# password. See config.yaml's delivery section for host/port/TLS.
BRIEFING_SMTP_USERNAME=
BRIEFING_SMTP_PASSWORD=
BRIEFING_FROM_ADDRESS=
BRIEFING_TO_ADDRESS=

# LLM briefing generation: https://console.anthropic.com
ANTHROPIC_API_KEY=
